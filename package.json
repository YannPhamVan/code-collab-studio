{
    "name": "code-collab-studio-root",
    "private": true,
    "scripts": {
        "dev": "concurrently -n \"frontend,backend\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
        "dev:frontend": "cd frontend && npm run dev",
        "dev:backend": "cd backend && uv run uvicorn app.main:app --reload --port 8000"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}
